# reflect — 밤에 하루를 돌아보는 1회성 작업. daijin-reflect.timer 가 띄운다. 손으로: systemctl --user start daijin-reflect
[Unit]
Description=daijin nightly reflection (memories, ledger labels, persona proposal)

[Service]
Type=oneshot
WorkingDirectory=__REPO__/voice
ExecStart=__PYTHON__ -u __REPO__/voice/reflect.py
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=__HOME__
Environment=PYTHONUNBUFFERED=1
