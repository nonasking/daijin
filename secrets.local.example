# daijin brain secrets — copy to secrets.local.txt (gitignored) at the repo root.
# One KEY=value per line. Read at runtime by voice/daijin_mqtt.py and the voice/*.sh helpers.

# --- Cloud MQTT broker (required). Free tier at https://www.hivemq.com/mqtt-cloud-broker/ works.
MQTT_CLOUD_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_CLOUD_PORT=8883
MQTT_CLOUD_USER=your-broker-user
MQTT_CLOUD_PASS=your-broker-password

# --- Optional local mosquitto (localhost:1883) bridged to the cloud broker.
# The helper scripts use it when it is up (much lower latency) and fall back to the cloud otherwise.
MQTT_USER=iot
MQTT_PASS=your-local-mosquitto-password

# --- Speech-to-text. groq = Groq Whisper API (whisper-large-v3-turbo, the same model as the local one; the free tier
# covers a household's worth of clips); whisper = local whisper.cpp (fast on a Mac GPU, tens of seconds on a small VPS).
# Empty = groq when GROQ_API_KEY is set, else whisper. groq falls back to the local model when it fails and the model exists.
STT_ENGINE=                    # whisper_server | groq | whisper. Empty = whisper_server when one is listening, else groq (with key), else whisper
GROQ_API_KEY=
WHISPER_URL=http://127.0.0.1:18080/inference   # whisper.cpp server (voice/systemd/whisper-server.service); only worth it on a GPU/home machine

# --- Claude auth for a headless brain (Linux server without a browser). On a machine where `claude` is logged in, run
# `claude setup-token` (Pro/Max subscription, 1-year token) and paste it here. Leave empty where `claude` is already logged in.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Text-to-speech. supertonic = local, on-device Korean TTS (pip install supertonic; no network, CPU is enough);
# edge = free MS neural voice (default, Mac and Linux; Linux needs ffmpeg); eleven = ElevenLabs (needs key); yuna = macOS built-in.
TTS_ENGINE=edge
SUPERTONIC_VOICE=M1            # built-in presets M1..M5, F1..F5
SUPERTONIC_STEPS=4             # 2..8: more steps = a little cleaner, slower (4 is ~0.2x real time on a 2-vCPU VPS)
TTS_VOLUME=0.6
ELEVEN_API_KEY=

# --- Brain: model for `claude -p` (default claude-sonnet-5-5; claude-haiku-5-5 answers faster, Sonnet judges better),
# reasoning effort (low|medium|high; low is right for a chat loop), and the cap on tool calls per turn.
BRAIN_MODEL=claude-sonnet-5-5
BRAIN_EFFORT=low
BRAIN_MAX_TURNS=12

# --- Fleet watcher reports (a node going offline or coming back): say = fixed sentence spoken at once (default);
# ask = hand the situation to the agent, which phrases it itself (slower by one agent turn).
FLEET_REPORT=say

# --- Self layer (docs/design-self-layer.md). The DB holds episodes, the rebuff ledger, drives, memories, persona versions.
SELF_DB=                       # empty = voice/daijin.db
INITIATIVE_QUIET=23-08         # no proactive speech between these hours (body danger excepted)
INITIATIVE_DAILY_BUDGET=3      # proactive lines per day from the initiative (fleet outage reports are not counted)
INITIATIVE_RESPONSE_WINDOW_S=600
INITIATIVE_DRY_RUN=1           # 1 = plan only, publish to daijin/initiative/plan, never speak. Run the first week like this.
REFLECT_MODEL=                 # empty = BRAIN_MODEL
REFLECT_EFFORT=medium
# --- Optional: a URL the brain fetches every 60 s while alive (Uptime Kuma "Push" monitor, healthchecks.io ...).
# The brain also publishes its own status to daijin/brain/status (retained, last will marks it offline).
HEARTBEAT_URL=
