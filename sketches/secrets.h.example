// Copy to sketches/<sketch>/secrets.h (gitignored). Same fields for 14-daijin and 15-home-node.
#pragma once

// Cloud MQTT broker (TLS). Root CA for Let's Encrypt is already in ca_cert.h.
// Give the device and the nodes their own credentials, limited to the topics they need: a node left outside
// should not hold a password that can talk to the agent. See docs/broker-credentials.md.
#define MQTT_HOST "xxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883
#define MQTT_USER "your-broker-user"
#define MQTT_PASS "your-broker-password"

// Optional: the home broker (mosquitto on a machine in the house, same WiFi). When the cloud is unreachable or the
// clock cannot be set (no internet), boards fall back to it and retry the cloud every 5 minutes. Plain MQTT, so only
// for a network you trust. Leave these out to use the cloud only. See broker_choice.h.
// #define MQTT_LOCAL_HOST "192.168.0.10"
// #define MQTT_LOCAL_PORT 1883
// #define MQTT_LOCAL_USER "iot"
// #define MQTT_LOCAL_PASS "your-local-mosquitto-password"

// Known WiFi networks. Boards join whichever is strongest; the ESP32 is 2.4 GHz only
// (on an iPhone hotspot enable "Maximize Compatibility").
#define WIFI_SSID  "home-wifi"
#define WIFI_PASS  "home-password"
#define WIFI_SSID2 "phone-hotspot"
#define WIFI_PASS2 "hotspot-password"
// Home nodes only (15-home-node): optional third network.
#define WIFI_SSID3 "second-hotspot"
#define WIFI_PASS3 "hotspot-password"
